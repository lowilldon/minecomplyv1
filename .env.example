# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT RS256 keypair — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste PEM contents here with literal \n for newlines
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Salt for SHA-256 api key hashing (any random string, keep secret)
API_KEY_SALT=change_me_to_a_random_secret_string

# Upstash Redis (for rate limiting) — optional, rate limiting is skipped if not set
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
